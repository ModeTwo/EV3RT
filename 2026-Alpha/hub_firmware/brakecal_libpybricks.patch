@@ -65,6 +65,34 @@ void pbio_dcmotor_stop_all(bool clear_parents) {
  *
  * @return                  @c true if all motors are coasting, @c false otherwise.
  */
+// ETrobo 2026-Alpha (2026-10-29): like pbio_dcmotor_all_coasting, but braking
+// (pup_motor_brake = zero voltage) also counts as passive, so that the IMU
+// can recalibrate its gyro bias while the robot stands still with brakes on.
+// (pbio_dcmotor_all_coasting checks dcmotors->, i.e. only the first motor.)
+bool pbio_dcmotor_all_passive(void) {
+    for (pbio_port_id_t port = PBDRV_CONFIG_FIRST_MOTOR_PORT; port <= PBDRV_CONFIG_LAST_MOTOR_PORT; port++) {
+        pbio_dcmotor_t *dcmotor;
+        pbio_error_t err = pbio_dcmotor_get_dcmotor(port, &dcmotor);
+        if (err != PBIO_SUCCESS) {
+            continue;
+        }
+        pbio_iodev_type_id_t type_id;
+        err = pbdrv_ioport_get_motor_device_type_id(port, &type_id);
+        if (err != PBIO_SUCCESS) {
+            continue;
+        }
+        if (dcmotor->actuation_now == PBIO_DCMOTOR_ACTUATION_COAST ||
+            dcmotor->actuation_now == PBIO_DCMOTOR_ACTUATION_BRAKE) {
+            continue;
+        }
+        if (dcmotor->actuation_now == PBIO_DCMOTOR_ACTUATION_VOLTAGE && dcmotor->voltage_now == 0) {
+            continue;
+        }
+        return false;
+    }
+    return true;
+}
